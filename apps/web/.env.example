# URL base do serviço de chamados (tickets-api). Só usada no servidor (padrão: http://localhost:3001).
TICKETS_API_URL=http://localhost:3001

# Token compartilhado com o tickets-api (header X-Service-Token). Fora de produção o padrão é
# dev-service-token, o mesmo do tickets-api. Em produção: obrigatório, ≥ 16 caracteres.
SERVICE_TOKEN=dev-service-token

# Segredo que assina o cookie de sessão. Em produção: obrigatório, ≥ 32 caracteres aleatórios.
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres

# Arquivo SQLite do web (conversas, mensagens e rascunhos). Padrão: web.db
WEB_DATABASE_FILE=web.db

# Modelo no formato provedor/modelo (model router do Mastra). Padrão: google/gemini-3.5-flash-lite
# (confirmado na API do Gemini). Reserva: google/gemini-3.1-flash-lite.
LLM_MODEL=google/gemini-3.5-flash-lite

# Chave do Google AI Studio (nível gratuito: 15 req/min, 500/dia). Sem ela, o chat avisa que o
# assistente não está configurado; login e histórico continuam funcionando.
GOOGLE_GENERATIVE_AI_API_KEY=
