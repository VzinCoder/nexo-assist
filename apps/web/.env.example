# Variáveis do web (Next.js: telas, login e rotas de API do chat).
# Copie para apps/web/.env (o `pnpm setup` faz isso se o arquivo não existir).
# Só GOOGLE_GENERATIVE_AI_API_KEY precisa ser preenchida para o chat responder; o resto tem padrão
# de desenvolvimento. Tudo é lido só no servidor (nada é NEXT_PUBLIC_*) e validado em src/env.ts.
# NODE_ENV não entra aqui: o Next define sozinho (development no `pnpm dev`, production no build).

# Chave da API do Gemini, usada pelo agent para gerar as respostas do chat.
# Obrigatória para o chat responder. Sem ela, login e histórico funcionam e o chat avisa que o
# assistente não está configurado. Padrão: vazia.
# Onde obter: Google AI Studio (https://aistudio.google.com) > "Get API key" > "Create API key".
# O nível gratuito basta (limite atual: 15 req/min e 500 req/dia). Nunca faça commit deste valor.
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo no formato provedor/modelo (model router do Mastra). Trocar de provedor exige a chave dele.
# Opcional. Padrão: google/gemini-3.5-flash-lite. Reserva testada: google/gemini-3.1-flash-lite.
LLM_MODEL=google/gemini-3.5-flash-lite

# URL base do tickets-api, chamada só pelo servidor do web.
# Opcional. Padrão: http://localhost:3001 (mesma porta do PORT do tickets-api).
TICKETS_API_URL=http://localhost:3001

# Token enviado ao tickets-api no header X-Service-Token; precisa ser IGUAL ao SERVICE_TOKEN do tickets-api.
# Opcional fora de produção (padrão: dev-service-token). Em produção: obrigatório, 16+ caracteres.
# Onde obter: gere um valor aleatório, ex.: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
SERVICE_TOKEN=dev-service-token

# Segredo que assina (HMAC) o cookie de sessão. Trocá-lo desloga todo mundo.
# Opcional fora de produção (sem valor, usa um segredo fixo de desenvolvimento).
# Em produção: obrigatório, 32+ caracteres aleatórios.
# Onde obter: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres

# Arquivo SQLite do web (conversas, mensagens, trace e rascunhos), relativo a apps/web (ou absoluto).
# Opcional. Padrão: web.db. As migrações são aplicadas ao abrir o banco e pelo `pnpm setup`.
WEB_DATABASE_FILE=web.db
