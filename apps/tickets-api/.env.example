# Ambiente: development, test ou production (padrão: development).
NODE_ENV=development

# Porta HTTP do serviço de chamados (padrão: 3001).
PORT=3001

# Interface em que o servidor escuta (padrão: 0.0.0.0).
HOST=0.0.0.0

# Nível de log do Fastify/pino: fatal, error, warn, info, debug, trace ou silent (padrão: info).
LOG_LEVEL=info

# Token exigido no header X-Service-Token (o web usa o mesmo valor).
# Fora de produção o padrão é "dev-service-token"; em produção é obrigatório, com 16+ caracteres.
SERVICE_TOKEN=dev-service-token

# Arquivo SQLite, relativo ao diretório do app (padrão: tickets.db).
DATABASE_FILE=tickets.db

# Simulação do legado instável: fração de requisições que recebem 503 (0 a 1, padrão: 0)
# e atraso em ms aplicado a cada requisição, exceto /health (inteiro >= 0, padrão: 0).
FAILURE_RATE=0
LATENCY_MS=0
