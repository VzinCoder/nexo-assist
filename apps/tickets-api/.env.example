# Variáveis do tickets-api (serviço de chamados legado simulado).
# Copie para apps/tickets-api/.env (o `pnpm setup` faz isso se o arquivo não existir).
# Todas são opcionais em desenvolvimento: sem .env, o serviço sobe com os padrões abaixo.
# Valores inválidos impedem a inicialização com uma mensagem que nomeia a variável (src/env.ts).

# Ambiente de execução: development, test ou production.
# Opcional. Padrão: development. Com production, SERVICE_TOKEN passa a ser obrigatório.
NODE_ENV=development

# Porta HTTP do serviço. O web aponta para ela em TICKETS_API_URL.
# Opcional. Padrão: 3001.
PORT=3001

# Interface de rede em que o servidor escuta (0.0.0.0 = todas; 127.0.0.1 = só local).
# Opcional. Padrão: 0.0.0.0.
HOST=0.0.0.0

# Nível de log do Fastify/pino: fatal, error, warn, info, debug, trace ou silent.
# Opcional. Padrão: info.
LOG_LEVEL=info

# Token que o web envia no header X-Service-Token; precisa ser IGUAL ao SERVICE_TOKEN do web.
# Opcional fora de produção (padrão: dev-service-token). Em produção: obrigatório, 16+ caracteres.
# Onde obter: gere um valor aleatório, ex.: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
SERVICE_TOKEN=dev-service-token

# Arquivo SQLite dos chamados, relativo a apps/tickets-api (ou caminho absoluto).
# Opcional. Padrão: tickets.db. É criado e populado com o seed na primeira execução.
DATABASE_FILE=tickets.db

# Simulação do legado instável (deixe 0 para uso normal).
# FAILURE_RATE: fração das requisições que recebem 503, de 0 a 1. Opcional. Padrão: 0.
# LATENCY_MS: atraso em ms aplicado a cada requisição, exceto /health (inteiro >= 0). Opcional. Padrão: 0.
FAILURE_RATE=0
LATENCY_MS=0
